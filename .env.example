# ── csdn-mcp configuration ──────────────────────────────────────────────
# Copy to `.env` and fill in the cookie. Never commit `.env`.

# REQUIRED for any write operation.
# Copy the whole string from: F12 → Network → any csdn.net request →
# Request Headers → Cookie.  It must contain `UserToken=` (HTTP-only, so
# `document.cookie` will NOT work).
CSDN_COOKIE=""

# Optional overrides
# CSDN_USERNAME=Leaderxin
# CSDN_LOG_LEVEL=warn          # silent | error | warn | info | debug
# CSDN_TIMEOUT_MS=20000
# CSDN_MAX_RETRIES=2
# CSDN_MIN_INTERVAL_MS=250     # spacing between ordinary requests
# CSDN_SAVE_INTERVAL_MS=11000  # spacing between saves (CSDN throttles below ~10s)
